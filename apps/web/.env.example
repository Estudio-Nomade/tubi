# Copiar a apps/web/.env.local y completar.
# Prioridad Next: .env.local > .env  (ninguno se commitea).
# Local first: apuntá al Supabase de esta máquina, no a un project ref de cloud
# sin DNS (síntoma típico en UI: "fetch failed" tras mail/contraseña en /registro).

# --- Supabase (infra) ---
# Valores reales:
#   supabase start
#   supabase status -o env
# Mapear:
#   API_URL   → NEXT_PUBLIC_SUPABASE_URL
#               (default CLI: http://127.0.0.1:54321; si otro proyecto ocupa
#               ese puerto, usá el HostPort de `docker port supabase_kong_Tubi`)
#   ANON_KEY  → NEXT_PUBLIC_SUPABASE_ANON_KEY  (preferí JWT legacy eyJ…;
#               sb_publishable_… puede fallar según versión del client)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side (Server Actions, Route Handlers, scripts).
# Nunca exponer al browser ni prefijar con NEXT_PUBLIC_.
# SERVICE_ROLE_KEY de status -o env → SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=

# --- Mapas (infra) ---
# Marketplace design: sin UI de mapa / GPS. Geocoding server-side opcional más adelante.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Web Push (VAPID) — generadas por el agente; privada NUNCA se commitea ---
# Regenerar: bunx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEUMqOEzqHUi_qeKxxAy41DhfGksHLmwgmvk6NNdsHOeUqGtvRw30KBLRuac_QgYGisGhSLJpOb-aOVQgjcn1_U
# VAPID_PRIVATE_KEY=   # solo en .env.local / secrets del host
VAPID_SUBJECT=mailto:ops@tubi.local

# --- Didit KYC (IdentityVerifier) — las pone el humano ---
# Dashboard Didit → API key + workflow KYC + webhook destination
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=   # secret_shared_key del destination (X-Signature-V2)
# DIDIT_API_BASE_URL=https://verification.didit.me
# Webhook URL a configurar en Didit: https://<tu-dominio>/api/webhooks/didit
# Sin API key: flujo manual de desarrollo en /conductor/kyc

# Si ves "fetch failed" / timeouts largos en signUp: conectividad al host de
# NEXT_PUBLIC_SUPABASE_URL (cloud muerto o sin .env.local), no el wizard de UI.
# Reiniciá `bun run dev` después de crear o cambiar .env.local.
